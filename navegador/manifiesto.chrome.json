{
  "manifest_version": 3,
  "name": "Esfinge",
  "version": "0.1.0",
  "description": "Rellena las contraseñas de tu bóveda de Esfinge sin salir del navegador.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "pagina.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Esfinge",
    "default_popup": "panel.html"
  },
  "background": {
    "service_worker": "fondo.js"
  }
}
