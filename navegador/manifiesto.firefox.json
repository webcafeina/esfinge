{
  "manifest_version": 3,
  "name": "Esfinge",
  "version": "0.1.0",
  "description": "Rellena las contraseñas de tu bóveda de Esfinge sin salir del navegador.",
  "icons": {
    "16": "iconos/16.png",
    "32": "iconos/32.png",
    "48": "iconos/48.png",
    "128": "iconos/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "esfinge@webcafeina.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "personallyIdentifyingInfo",
          "browsingActivity"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "pagina.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Esfinge",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "iconos/barra-activo-16.png",
      "32": "iconos/barra-activo-32.png"
    }
  },
  "background": {
    "scripts": [
      "fondo.js"
    ]
  }
}
