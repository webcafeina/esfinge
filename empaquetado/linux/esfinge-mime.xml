<?xml version="1.0" encoding="UTF-8"?>
<!-- Declara qué es un fichero .esf, para que el escritorio le ponga su icono y
     lo abra con Esfinge al hacer doble clic. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-esfinge">
    <comment>Contenedor de Esfinge</comment>
    <comment xml:lang="en">Esfinge encrypted container</comment>
    <glob pattern="*.esf"/>
    <!-- Todo contenedor empieza por estos cuatro bytes. -->
    <magic priority="60">
      <match type="string" value="ESF1" offset="0"/>
    </magic>
    <!-- El icono del documento, no el de la aplicación. Aquí ponía «esfinge»,
         que es el del programa, así que un .esf y Esfinge se veían igual en el
         explorador de ficheros: el mismo fallo que hubo en macOS.
         El nombre es el del tipo con la barra cambiada por un guion, que es la
         convención de freedesktop, y el paquete instala el fichero con ese
         nombre en hicolor/<tamaño>/mimetypes/. -->
    <icon name="application-x-esfinge"/>
  </mime-type>
</mime-info>
